grommit_target(florp, target) :- relation(florp, "grommits", target).
grommit_confidence(florp, confidence) :- relation_property_float(florp, "grommits", _, "confidence", confidence).
florp_details(florp, title, count_value, score, enabled, observed, label) :- entity_property_string(florp, "title", title), entity_property_integer(florp, "count", count_value), entity_property_float(florp, "score", score), entity_property_boolean(florp, "enabled", enabled), entity_property_datetime(florp, "observed", observed), entity_property_string(florp, "labels", label).
florp_without_labels(florp) :- entity_type(florp, "florp"), !entity_property_string(florp, "labels", _).
related_florp(source, target) :- entity_property_string(source, "related", target), entity(target).
scalar_float(value) :- value = 3.5.
scalar_values(integer, float, boolean, text) :- integer = 42, scalar_float(float), boolean = 1, text = "left\tright".
reachable_florp(source, target) :- relation(source, "precedes", target).
reachable_florp(source, target) :- relation(source, "precedes", middle), reachable_florp(middle, target).
blocked_florp(florp) :- relation(_, "precedes", florp).
ready_florp(florp) :- entity_type(florp, "florp"), !blocked_florp(florp).
ready_florp_command(florp, "") :- ready_florp(florp).
ready_florp_command(florp, label) :- ready_florp(florp), entity_property_string(florp, "labels", label).
